# 複製這個檔案成 .env，把金鑰填進去（.env 已被 .gitignore 排除，不會進版控）

# 後端網址（正式環境不用改）
API_BASE=https://sansoon-api-702692123354.asia-east1.run.app

# 匯入專用金鑰：必須與後端的 IMPORT_API_KEY 環境變數完全一樣。
# 產生方式（PowerShell）： [Convert]::ToBase64String((1..32|%{Get-Random -Max 256}))
IMPORT_API_KEY=

# 多久掃一次資料夾（秒）
POLL_SECONDS=60

# 當天的派遣單即使內容沒變，每幾分鐘也重送一次，讓被刪掉的資料自己補回來。
# 設 0 可關閉（就回到只看內容有沒有變的舊行為）。
RECHECK_MINUTES=15

# 要監看的資料夾。搬到別台電腦時改這裡就好，不用改程式。
DIR_SELF=C:\server\出貨派遣
DIR_HSINCHU=C:\server\新竹貨運
DIR_DALEN=C:\server\大榮貨運
DIR_YONGCHANG=C:\server\永昌回頭車
