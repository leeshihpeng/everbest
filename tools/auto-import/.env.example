# 複製這個檔案成 .env，把金鑰填進去（.env 已被 .gitignore 排除，不會進版控）

# 後端網址（正式環境不用改）
API_BASE=https://everbest.onrender.com

# 匯入專用金鑰：必須與 Render 環境變數 IMPORT_API_KEY 完全一樣。
# 產生方式（PowerShell）： [Convert]::ToBase64String((1..32|%{Get-Random -Max 256}))
IMPORT_API_KEY=

# 多久掃一次資料夾（秒）
POLL_SECONDS=60

# 要監看的資料夾。搬到別台電腦時改這裡就好，不用改程式。
DIR_SELF=C:\server\出貨派遣
DIR_HSINCHU=C:\server\新竹貨運
DIR_DALEN=C:\server\大榮貨運
